@using AspnetCoreMvcStarter.Models
@{
  TempData.Keep();
  string currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
  string currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
  string? currentUserRole = ViewContext.HttpContext.Session.GetString("UserRole");
}

<!-- Menu -->
<aside id="layout-menu" class="layout-menu menu-vertical menu bg-menu-theme">
  <div class='app-brand demo'>
    <a asp-controller="Home" asp-action="Index" class="app-brand-link">
      <span class="app-brand-logo demo me-1"><img src="https://upload.wikimedia.org/wikipedia/vi/6/65/VNPT_Logo.svg" alt="" srcset="" style="width: 30px"></span>
      <span class="app-brand-text demo menu-text fw-semibold ms-2">VNPT</span>
    </a>
    <a href="javascript:void(0);" class="layout-menu-toggle menu-link text-large ms-auto">
      <i class="menu-icon tf-icons ri-menu-2-line"></i>
    </a>
  </div>

  <div class="menu-inner-shadow"></div>

  <ul class="menu-inner py-1">
    <!-- Dashboard -->
    <li class='menu-item@(currentController == "Home" ? " active" : "")'>
      <a asp-controller="Home" asp-action="Index" class="menu-link">
        <i class="menu-icon tf-icons ri-home-smile-line"></i>
        <div>Dashboard</div>
      </a>
    </li>

    @* ==================== PHÂN KHÚC ADMIN ==================== *@
    @if (currentUserRole == UserRole.Admin.ToString())
    {
      <li class="menu-header"><span class="menu-header-text">Quản trị hệ thống</span></li>

      <!-- Quản lý Phòng ban -->
      <li class='menu-item@(currentController == "Departments" ? " active open" : "")'>
        <a href='javascript:void(0);' class='menu-link menu-toggle'>
          <i class="menu-icon tf-icons ri-building-4-line"></i>
          <div>Quản lý Phòng ban</div>
        </a>
        <ul class='menu-sub'>
          <li class='menu-item@(currentAction == "Index" ? " active" : "")'>
            <a asp-controller="Departments" asp-action="Index" class="menu-link"><div>Danh sách</div></a>
          </li>
          <li class='menu-item@(currentAction == "Create" ? " active" : "")'>
            <a asp-controller="Departments" asp-action="Create" class="menu-link"><div>Tạo mới</div></a>
          </li>
        </ul>
      </li>

      <!-- Quản lý Nhóm CV (JobType) -->
      <li class='menu-item@(currentController == "JobTypes" ? " active open" : "")'>
        <a href='javascript:void(0);' class='menu-link menu-toggle'>
          <i class="menu-icon tf-icons ri-briefcase-4-line"></i>
          <div>Quản lý Nhóm CV</div>
        </a>
        <ul class='menu-sub'>
          <li class='menu-item@(currentAction == "Index" ? " active" : "")'>
            <a asp-controller="JobTypes" asp-action="Index" class="menu-link"><div>Danh sách</div></a>
          </li>
          <li class='menu-item@(currentAction == "Create" ? " active" : "")'>
            <a asp-controller="JobTypes" asp-action="Create" class="menu-link"><div>Tạo mới</div></a>
          </li>
        </ul>
      </li>

      <!-- Quản lý Danh mục CV (TaskDefinition) -->
      <li class='menu-item@(currentController == "TaskDefinitions" ? " active open" : "")'>
        <a href='javascript:void(0);' class='menu-link menu-toggle'>
          <i class="menu-icon tf-icons ri-list-check-2"></i>
          <div>Quản lý Danh mục CV</div>
        </a>
        <ul class='menu-sub'>
          <li class='menu-item@(currentAction == "Index" ? " active" : "")'>
            <a asp-controller="TaskDefinitions" asp-action="Index" class="menu-link"><div>Danh sách</div></a>
          </li>
          <li class='menu-item@(currentAction == "Create" ? " active" : "")'>
            <a asp-controller="TaskDefinitions" asp-action="Create" class="menu-link"><div>Tạo mới</div></a>
          </li>
        </ul>
      </li>

      <!-- Quản lý Người dùng -->
      <li class='menu-item@(currentController == "User" ? " active open" : "")'>
        <a href='javascript:void(0);' class='menu-link menu-toggle'>
          <i class="menu-icon tf-icons ri-user-settings-line"></i>
          <div>Quản lý Người dùng</div>
        </a>
        <ul class='menu-sub'>
          <li class='menu-item@(currentAction == "Index" ? " active" : "")'>
            <a asp-controller="User" asp-action="Index" class="menu-link"><div>Danh sách</div></a>
          </li>
          <li class='menu-item@(currentAction == "Create" ? " active" : "")'>
            <a asp-controller="User" asp-action="Create" class="menu-link"><div>Tạo mới</div></a>
          </li>
        </ul>
      </li>
    }

    @* ==================== PHÂN KHÚC CHUYÊN VIÊN ==================== *@
    @if (currentUserRole == UserRole.Employee.ToString())
    {
      <li class="menu-header"><span class="menu-header-text">Công việc cá nhân</span></li>
      <li class='menu-item@(currentController == "KpiTasks" ? " active open" : "")'>
        <a href='javascript:void(0);' class='menu-link menu-toggle'>
          <i class="menu-icon tf-icons ri-task-line"></i>
          <div>Công việc KPI</div>
        </a>
        <ul class='menu-sub'>
          <li class='menu-item@(currentAction == "Create" ? " active" : "")'>
            <a asp-controller="KpiTasks" asp-action="Create" class="menu-link"><div>Đăng ký công việc</div></a>
          </li>
          <li class='menu-item@(currentAction == "MyTask" ? " active" : "")'>
            <a asp-controller="KpiTasks" asp-action="MyTask" class="menu-link"><div>Công việc của tôi</div></a>
          </li>
        </ul>
      </li>
    }

    @* ==================== PHÂN KHÚC LÃNH ĐẠO ==================== *@
    @if (currentUserRole == UserRole.Leader.ToString())
    {
        <li class="menu-header"><span class="menu-header-text">Quản lý nhóm</span></li>
        <li class='menu-item@(currentController == "KpiTasks" && currentAction == "ReviewList" ? " active" : "")'>
            <a asp-controller="KpiTasks" asp-action="ReviewList" class="menu-link">
                <i class="menu-icon tf-icons ri-user-follow-line"></i>
                <div>Duyệt công việc</div>
            </a>
        </li>
    }

    @* ==================== PHÂN KHÚC BÁO CÁO (CHUNG) ==================== *@
    <li class="menu-header"><span class="menu-header-text">Báo cáo</span></li>
     <li class='menu-item@(currentController == "KpiReports" ? " active open" : "")'>
      <a href='javascript:void(0);' class='menu-link menu-toggle'>
        <i class="menu-icon tf-icons ri-file-chart-2-line"></i><div>Báo cáo KPI</div>
      </a>
      <ul class='menu-sub'>
        @if (currentUserRole == UserRole.Leader.ToString() || currentUserRole == UserRole.Admin.ToString())
        {
          <li class='menu-item@(currentAction == "TeamReport" ? " active" : "")'>
            <a asp-controller="KpiReports" asp-action="TeamReport" class="menu-link"><div>Báo cáo nhóm</div></a>
          </li>
        }
        <li class='menu-item@(currentAction == "MyReport" ? " active" : "")'>
          <a asp-controller="KpiReports" asp-action="MyReport" class="menu-link"><div>Báo cáo cá nhân</div></a>
        </li>
      </ul>
    </li>
  </ul>
</aside>
<!-- / Menu -->
