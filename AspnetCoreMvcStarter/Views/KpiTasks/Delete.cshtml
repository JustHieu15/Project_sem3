@model AspnetCoreMvcStarter.Models.KpiTask
@{
  ViewData["Title"] = "Xóa Công Việc KPI";
}

<div class="container mt-4">
  <div class="card">
    <div class="card-header bg-danger text-white">
      <h4 class="mb-0">Xóa Công Việc KPI: @Model.TaskDefinition.Name</h4>
    </div>
    <div class="card-body">
      <h5>Bạn có chắc chắn muốn xóa công việc này?</h5>
      <p class="text-danger">Hành động này không thể hoàn tác.</p>

      <dl class="row">
        <dt class="col-sm-3">Tên công việc</dt>
        <dd class="col-sm-9">@Model.TaskDefinition.Name</dd>
        <dt class="col-sm-3">Nhóm công việc</dt>
        <dd class="col-sm-9">@(Model.TaskDefinition.JobType?.Name ?? "N/A")</dd>
        <dt class="col-sm-3">Trạng thái hiện tại</dt>
        <dd class="col-sm-9">@Model.Status.ToString()</dd>
      </dl>

      <form asp-action="Delete" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <button type="submit" class="btn btn-danger">
          <i class="fas fa-trash"></i> Xóa
        </button>
        <a asp-action="MyTask" class="btn btn-secondary ms-2">
          <i class="fas fa-arrow-left"></i> Hủy
        </a>
      </form>
    </div>
  </div>
</div>
