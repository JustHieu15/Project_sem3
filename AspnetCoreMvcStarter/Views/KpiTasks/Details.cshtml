@model AspnetCoreMvcStarter.Models.KpiTask
@using AspnetCoreMvcStarter.Models
@using AspnetCoreMvcStarter.Extend
@using TaskStatus = AspnetCoreMvcStarter.Models.TaskStatus
@{
    ViewData["Title"] = "Chi tiết Công việc";
    var currentUserRole = Context.Session.GetString("UserRole");
    bool isLeader = currentUserRole == UserRole.Leader.ToString();
    var allDepartments = ViewBag.AllDepartments as List<Department>;
    var selectedRelatedDeptIds = Model.RelatedDepartmentIds?.Split(',', StringSplitOptions.RemoveEmptyEntries) ?? new string[0];
}

<h4 class="mb-3">Chi tiết công việc: @Model.TaskDefinition.Name</h4>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Details" asp-route-id="@Model.Id" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="TaskDefinitionId" />

    <div class="card">
        <div class="card-body">
            <div class="row">
                <!-- Cột trái -->
                <div class="col-md-8">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Nhóm công việc</label>
                        <input value="@Model.TaskDefinition?.JobType?.Name" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Tên Công việc</label>
                        <input value="@Model.TaskDefinition?.Name" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label asp-for="DetailedDescription" class="form-label"></label>
                        <textarea asp-for="DetailedDescription" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="DetailedDescription" class="text-danger"></span>
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label asp-for="ApproverId" class="form-label"></label>
                            <select asp-for="ApproverId" class="form-select" asp-items="ViewBag.ApproverId">
                                <option value="">-- Chọn lãnh đạo --</option>
                            </select>
                            <span asp-validation-for="ApproverId" class="text-danger"></span>
                        </div>
                        <div class="col">
                             <label asp-for="UserProposedPoints" class="form-label"></label>
                             <input type="number" asp-for="UserProposedPoints" class="form-control" />
                             <span asp-validation-for="UserProposedPoints" class="text-danger"></span>
                        </div>
                    </div>
                     <div class="row mb-3">
                        <div class="col">
                            <label asp-for="DeadlineInDocument" class="form-label"></label>
                            <input type="date" asp-for="DeadlineInDocument" class="form-control" />
                            <span asp-validation-for="DeadlineInDocument" class="text-danger"></span>
                        </div>
                        <div class="col">
                            <label asp-for="Status" class="form-label"></label>
                            <select asp-for="Status" asp-items="Html.GetEnumSelectList<TaskStatus>()" class="form-select"></select>
                            <span asp-validation-for="Status" class="text-danger"></span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label asp-for="ReasonForIncompletion" class="form-label"></label>
                        <textarea asp-for="ReasonForIncompletion" class="form-control" rows="2"></textarea>
                        <span asp-validation-for="ReasonForIncompletion" class="text-danger"></span>
                    </div>
                     <div class="row mb-3">
                        <div class="col">
                            <label asp-for="MainDepartmentId" class="form-label"></label>
                            <select asp-for="MainDepartmentId" class="form-select" asp-items="ViewBag.MainDepartmentId">
                                <option value="">-- Chọn ĐV Chủ trì --</option>
                            </select>
                            <span asp-validation-for="MainDepartmentId" class="text-danger"></span>
                        </div>
                        <div class="col">
                            <label name="RelatedDepartmentIds" class="form-label">(Giữ Ctrl để chọn nhiều)</label>
                            <select name="RelatedDepartmentIds" class="form-select" multiple size="4">
                                @if(allDepartments != null)
                                {
                                    foreach (var dept in allDepartments)
                                    {
                                        var isSelected = selectedRelatedDeptIds.Contains(dept.Id.ToString());
                                        <option value="@dept.Id" selected="@isSelected">@dept.Name</option>
                                    }
                                }
                            </select>
                        </div>
                    </div>
                </div>
                <!-- Cột phải -->
                <div class="col-md-4">
                  <div class="card bg-light">
                    <div class="card-body">
                      <h5 class="card-title">Phần dành cho Lãnh đạo</h5>
                      <div class="mb-3">
                        <label asp-for="LeaderApprovedPoints" class="form-label"></label>
                        @if (isLeader)
                        {
                          <input type="number" asp-for="LeaderApprovedPoints" class="form-control" />
                        }
                        else
                        {
                          <input type="number" asp-for="LeaderApprovedPoints" class="form-control" readonly />
                          <small class="text-muted">Chỉ lãnh đạo có thể sửa.</small>
                        }
                        <span asp-validation-for="LeaderApprovedPoints" class="text-danger"></span>
                      </div>
                    </div>
                  </div>
                  <div class="card mt-3">
                    <div class="card-body">
                      <h5 class="card-title">Thông tin chung</h5>
                      <p><strong>Người thực hiện:</strong> @(Model.AssignedUser?.Name ?? "N/A")</p>
                      <p><strong>Ngày tạo:</strong> @Model.CreatedDate.ToString("dd/MM/yyyy")</p>
                      <p><strong>Cập nhật lần cuối:</strong> @(Model.UpdatedDate?.ToString("dd/MM/yyyy HH:mm") ?? "Chưa có")</p>
                    </div>
                  </div>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
                <a asp-action="MyTask" class="btn btn-secondary">Quay lại danh sách của tôi</a>
            </div>
        </div>
    </div>
</form>
