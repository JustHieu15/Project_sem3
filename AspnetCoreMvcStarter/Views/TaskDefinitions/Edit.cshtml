@model AspnetCoreMvcStarter.Models.TaskDefinition

@{
    ViewData["Title"] = "Chỉnh sửa Danh mục Công việc";
}

<h4>@ViewData["Title"]</h4>
<hr />

<div class="row">
    <div class="col-md-8">
        <div class="card mb-4">
            <div class="card-body">
                <form asp-action="Edit">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="Id" />

                    <div class="mb-3">
                        <label asp-for="JobTypeId" class="form-label"></label>
                        <select asp-for="JobTypeId" class="form-select" asp-items="ViewBag.JobTypeId"></select>
                        <span asp-validation-for="JobTypeId" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DefaultPoints" class="form-label"></label>
                        <input asp-for="DefaultPoints" type="number" class="form-control" />
                        <span asp-validation-for="DefaultPoints" class="text-danger"></span>
                    </div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" asp-for="IsActive">
                        <label class="form-check-label" asp-for="IsActive">
                            @Html.DisplayNameFor(model => model.IsActive)
                        </label>
                    </div>

                    <div class="mt-2">
                        <button type="submit" class="btn btn-primary me-2">Lưu thay đổi</button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
