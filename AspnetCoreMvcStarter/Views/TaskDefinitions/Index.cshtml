@model IEnumerable<AspnetCoreMvcStarter.Models.TaskDefinition>

@{
    ViewData["Title"] = "Quản lý Danh mục Công việc";
}

<h4>@ViewData["Title"]</h4>
<p>
    Đây là danh sách các công việc mẫu. Chuyên viên sẽ chọn từ danh sách này để tạo công việc cụ thể cho mình.
</p>

<p>
    <a asp-action="Create" class="btn btn-primary">
        <i class="ri-add-line me-1"></i> Tạo mới
    </a>
</p>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}

<div class="card">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>@Html.DisplayNameFor(model => model.Name)</th>
                    <th>@Html.DisplayNameFor(model => model.JobType)</th>
                    <th>@Html.DisplayNameFor(model => model.DefaultPoints)</th>
                    <th>@Html.DisplayNameFor(model => model.IsActive)</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@Html.DisplayFor(modelItem => item.Name)</strong></td>
                        <td>@Html.DisplayFor(modelItem => item.JobType.Name)</td>
                        <td><span class="badge bg-label-info">@Html.DisplayFor(modelItem => item.DefaultPoints)</span></td>
                        <td>
                            @if (item.IsActive)
                            {
                                <span class="badge bg-label-success">Hoạt động</span>
                            }
                            else
                            {
                                <span class="badge bg-label-secondary">Không hoạt động</span>
                            }
                        </td>
                        <td>
                             <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Sửa</a>
                             <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Xóa</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
